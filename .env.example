# ── Core ─────────────────────────────────────────────────────────────────────
# 32+ character secret used to sign session cookies AND encrypt Daraja
# credentials stored in the database. CHANGE THIS IN PRODUCTION.
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Public base URL of the site (used for SEO metadata + sitemap).
APP_URL=http://localhost:3000

# SQLite database location. Railway mounts a persistent volume at /data.
DATABASE_URL=file:./gcn.sqlite

# ── First admin (created automatically on first boot — change in Admin later) ─
ADMIN_NAME=Green Admin
ADMIN_PHONE=254700000000
# NOTE: always quote values containing # (dotenv treats it as a comment)
ADMIN_PASSWORD="Admin#2026"

# ── Local demo only ──────────────────────────────────────────────────────────
# When "true", the M-Pesa STK push is simulated locally (no Daraja call, no
# internet needed) so the full purchase flow can be demonstrated offline.
# MUST be "false" in production.
MPESA_SIMULATE=true
